# Copy to .env before the first `docker compose up`.
#
# These are local development values for containers bound to loopback. They are
# not secrets and are not a template for production, where every one of these
# should come from the platform's secret store and none should have a default.

POSTGRES_DB=passless
POSTGRES_USER=passless
POSTGRES_PASSWORD=passless
POSTGRES_PORT=5432

REDIS_PORT=6379
